<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the chatbox disconnect its Web socket when offline, and connect it back once online -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lets CrispWebViewSupport tell if a Play Store can open the WebView update page -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application>
        <provider
            android:name="im.crisp.sdk.internal.upload.CrispFileProvider"
            android:authorities="${applicationId}.im.crisp.sdk.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/crisp_sdk_file_paths" />
        </provider>
    </application>

</manifest>